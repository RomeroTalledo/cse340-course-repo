<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <ul>

        <% projects.forEach(project => { %>

            <li>

                <strong>
                    <%= new Date(project.start_date).toLocaleDateString() %>
                </strong>

                :

                <%= project.project_name %>

                (
                <%= project.organization_name %>
                )

            </li>

        <% }) %>

    </ul>

</main>

<%- include('partials/footer') %>