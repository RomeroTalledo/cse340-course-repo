<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= project.project_name %></h2>
    <p><%= project.description %></p>
    <p>Location: <%= project.location %></p>
    <p>Date: <%= project.date %></p>
    <p>Organization: 
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Project Categories</a></p>
    <% } %>

    <% if (isLoggedIn) { %>
        <% if (isVolunteering) { %>
            <p>You are volunteering for this project.</p>
            <form action="/remove-volunteer/<%= project.project_id %>" method="POST">
                <button type="submit">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form action="/volunteer/<%= project.project_id %>" method="POST">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
    <% } %>

    <h3>Categories</h3>
    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.category_name %>
                </a>
            </li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>