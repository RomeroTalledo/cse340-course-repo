<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= organizationDetails.name %></h2>
    <p><%= organizationDetails.description %></p>
    <p>Contact: <%= organizationDetails.contact_email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>
    <% } %>

    <h3>Projects</h3>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <%= project.project_name %>
                </a>
            </li>
        <% }) %>
    </ul>
</main>
<%- include('partials/footer') %>